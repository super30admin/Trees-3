# Definition for a binary tree node.
import copy
class TreeNode:
    def __init__(self, val=0, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right

## Deepcopy
class Solution1:
    def pathSum(self, root, targetSum: int) -> list[list[int]]:
        '''
        TC: O(n^2)
        AS: O(n^2)
        '''
        result = [] 
        curr = 0 

        def helper(root, path, curr, targetSum):

            nonlocal result
            li = copy.deepcopy(path)

            ## base condition 
            if root is None:
                return 
            
            ## logic
            curr += root.val

            #### Action
            li.append(root.val)
            if root.left is None and root.right is None:
                if curr == targetSum:
                    # print(li)
                    result.append(li)

            #### Recurse
            helper(root.left, li, curr, targetSum)
            helper(root.right, li, curr, targetSum)

        helper(root, [], curr, targetSum)
        return result
    

## BackTrack and Deepcopy
class Solution2:
    def pathSum(self, root, targetSum: int) -> list[list[int]]:
        '''
        TC: O(n), where n is the number of nodes
        AS: O(h), where h is the height of the tree
        '''
        result = [] 

        def helper(root, path, curr, targetSum):

            ## base condition 
            if root is None:
                return 
            
            ## logic
            curr += root.val

            #### Action
            path.append(root.val)
            if root.left is None and root.right is None:
                if curr == targetSum:
                    # print(path)
                    result.append(copy.deepcopy(path))

            #### Recurse
            helper(root.left, path, curr, targetSum)
            helper(root.right, path, curr, targetSum)

            #### Backtrack
            path.pop()

        # helper(root, path, curr, targetSum) ## initially path = [], curr = 0
        helper(root, [], 0, targetSum)
        return result

